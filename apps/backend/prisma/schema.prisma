// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Roles del sistema
enum Role {
  PMO
  LEAD
}

/// Estados manuales de subtask
enum WorkState {
  PENDING
  IN_PROGRESS
  DONE
  LATE
}

enum DependencyType {
  FINISH_START
  START_START
  FINISH_FINISH
}

enum SnapshotRange {
  WEEKLY
  MONTHLY
  PROJECT
}

model User {
  id          String   @id @default(uuid())
  email       String   @unique
  password    String
  name        String
  role        Role
  color       String   @default("#0097A7")
  hourlyRate  Decimal  @db.Decimal(12, 2)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  memberships TeamMembership[]
  assignments SubtaskAssignment[]
  teamsLed    Team[]
}

model Project {
  id             String    @id @default(uuid())
  name           String
  code           String    @unique
  description    String?
  status         String    @default("planning")
  startDate      DateTime?
  endDate        DateTime?
  budgetTotal    Decimal   @db.Decimal(14, 2)
  currency       String    @default("EUR")
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  teams          Team[]
  epics          Epic[]
  budgets        BudgetHistory[]
  snapshots      ProgressSnapshot[]
  costLedgers    CostLedger[]
  memberships    TeamMembership[]
}

model Team {
  id          String   @id @default(uuid())
  name        String
  projectId   String
  leadId      String
  color       String    @default("#607D8B")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  project     Project  @relation(fields: [projectId], references: [id])
  lead        User     @relation(fields: [leadId], references: [id])
  memberships TeamMembership[]
  tasks       Task[]
}

model TeamMembership {
  id        String  @id @default(uuid())
  userId    String
  teamId    String
  projectId String
  hourlyRate Decimal? @db.Decimal(12, 2)

  user      User    @relation(fields: [userId], references: [id])
  team      Team    @relation(fields: [teamId], references: [id])
  project   Project @relation(fields: [projectId], references: [id])

  @@unique([userId, teamId, projectId])
}

model Epic {
  id          String    @id @default(uuid())
  projectId   String
  name        String
  code        String
  description String?
  status      String    @default("draft")
  startDate   DateTime?
  endDate     DateTime?
  progress    Float     @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  project     Project  @relation(fields: [projectId], references: [id])
  tasks       Task[]

  @@unique([projectId, code])
}

model Task {
  id          String    @id @default(uuid())
  epicId      String
  teamId      String?
  name        String
  description String?
  order       Int       @default(0)
  startDate   DateTime?
  endDate     DateTime?
  progress    Float     @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  epic        Epic      @relation(fields: [epicId], references: [id])
  team        Team?     @relation(fields: [teamId], references: [id])
  subtasks    Subtask[]
}

model Subtask {
  id             String    @id @default(uuid())
  taskId         String
  name           String
  description    String?
  order          Int       @default(0)
  state          WorkState @default(PENDING)
  progress       Float     @default(0)
  startDate      DateTime?
  endDate        DateTime?
  estimatedHours Float?
  durationDays   Int?
  isDelayed      Boolean   @default(false)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  task           Task      @relation(fields: [taskId], references: [id])
  assignments    SubtaskAssignment[]
  dependencies   Dependency[]        @relation("Blocking")
  blockedBy      Dependency[]        @relation("Blocked")
}

model SubtaskAssignment {
  id          String   @id @default(uuid())
  subtaskId   String
  userId      String
  color       String
  hourlyRate  Decimal  @db.Decimal(12, 2)
  allocation  Float    @default(1)

  subtask     Subtask @relation(fields: [subtaskId], references: [id])
  user        User    @relation(fields: [userId], references: [id])

  @@unique([subtaskId, userId])
}

model Dependency {
  id             String         @id @default(uuid())
  blockerId      String
  blockedId      String
  type           DependencyType @default(FINISH_START)

  blocker        Subtask @relation("Blocking", fields: [blockerId], references: [id])
  blocked        Subtask @relation("Blocked", fields: [blockedId], references: [id])

  @@unique([blockerId, blockedId])
}

model BudgetHistory {
  id          String   @id @default(uuid())
  projectId   String
  label       String
  amount      Decimal  @db.Decimal(14, 2)
  createdAt   DateTime @default(now())
  note        String?

  project     Project  @relation(fields: [projectId], references: [id])
}

model ProgressSnapshot {
  id              String        @id @default(uuid())
  projectId       String
  rangeType       SnapshotRange
  periodStart     DateTime
  periodEnd       DateTime
  percentComplete Float
  plannedCost     Decimal? @db.Decimal(14, 2)
  actualCost      Decimal? @db.Decimal(14, 2)
  earnedValue     Decimal? @db.Decimal(14, 2)

  project         Project @relation(fields: [projectId], references: [id])

  @@index([projectId, periodStart, periodEnd])
}

model CostLedger {
  id            String   @id @default(uuid())
  projectId     String
  month         DateTime
  plannedCost   Decimal? @db.Decimal(14, 2)
  actualCost    Decimal? @db.Decimal(14, 2)
  producedValue Decimal? @db.Decimal(14, 2)
  budgetBurn    Decimal? @db.Decimal(14, 2)

  project       Project @relation(fields: [projectId], references: [id])

  @@unique([projectId, month])
}
